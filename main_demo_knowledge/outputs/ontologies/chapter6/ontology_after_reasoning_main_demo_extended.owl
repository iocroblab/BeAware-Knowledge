<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology"
         xmlns="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:beaw="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#">

<owl:Ontology rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology">
  <owl:imports rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Main Demo scenario ontology for the BeAware Framework. Base pass: world structure (Room/Location/Surface), Navigate/Move/Pick/Place behaviors. Flavors, Context Modes and MRS to be added in later passes.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#ApplicationProperties">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Parent property for relations used only by the application, not planned over in PDDL</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#PDDLProperties">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Parent property for all PDDL predicates in this scenario</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasGripper">
  <rdfs:subPropertyOf rdf:resource="#ApplicationProperties"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="#Gripper"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only relation (not planned over, not part of the PDDL knowledge): the end-effector fitted on this Robot</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSensor">
  <rdfs:subPropertyOf rdf:resource="#ApplicationProperties"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only relation (not planned over, not part of the PDDL knowledge): a perception device fitted on this Robot</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#location_in_room">
  <rdfs:subPropertyOf rdf:resource="#ApplicationProperties"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Location"/>
  <rdfs:range rdf:resource="#Room"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only relation (not planned over): this Location belongs to this Room</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#object_on_surface">
  <rdfs:subPropertyOf rdf:resource="#PDDLProperties"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManipulationObject"/>
  <rdfs:range rdf:resource="#Surface"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PDDL predicate: object is currently placed on this Surface</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#robot_at_location">
  <rdfs:subPropertyOf rdf:resource="#PDDLProperties"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="#Location"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PDDL predicate: robot's base is currently at this Location (changed by Navigate)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#robot_at_surface">
  <rdfs:subPropertyOf rdf:resource="#PDDLProperties"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="#Surface"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PDDL predicate: robot's arm is currently reaching this Surface, within the current Location (changed by Move)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#robot_holding">
  <rdfs:subPropertyOf rdf:resource="#PDDLProperties"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="#ManipulationObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PDDL predicate: robot is currently holding this object</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#surface_in_location">
  <rdfs:subPropertyOf rdf:resource="#PDDLProperties"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Surface"/>
  <rdfs:range rdf:resource="#Location"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PDDL predicate (static): this Surface belongs to this Location</rdfs:comment>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasBattery">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Robot's current battery level (0-100). Numeric PDDL fluent; the planner may not support numeric fluents, in which case this stays ontology-only.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasLowBattery">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True when the value of hasBattery for the Robot is below 65. Modeled as a boolean data property rather than a class because hasBattery changes continuously during execution. Inferred by SWRL rule rule_low_battery_robot: Robot(?x) ^ hasBattery(?x,?b) ^ swrlb:lessThan(?b,65.0) -&gt; hasLowBattery(?x,true).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasFixedEndEffector">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True when the Robot has a single, non-interchangeable end-effector (its one hasGripper never needs to be selected among alternatives). Asserted directly per Robot, since it reflects a fixed hardware configuration rather than a dynamic runtime condition.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#grasp_force">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: current measured grasp force reading from the wrist force/torque sensor, in Newtons. Used for documentation purposes by the MRS Flavors that monitor grasp force (`p_check_grasp_force`); not read by any real BT node since ch08's correctness checks are structural-BT-generation-only.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#vacuum_pressure">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: current measured suction vacuum pressure reading, in kPa. Used for documentation purposes by the MRS Flavors that monitor vacuum pressure (`p_check_vacuum_pressure`); not read by any real BT node since ch08's correctness checks are structural-BT-generation-only.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#grip_force">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: current commanded parallel-gripper closing force set-point, in Newtons. Documents the value adapted by the `ParameterAdaptiveRetry` MRS Flavor's inline Script (`hasParameterModification`) between retries; the actual adaptation happens on a BT blackboard variable, not by writing back to this ontology property.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hand_empty">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PDDL predicate: robot's gripper/hand is free</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasBBoxMaxX">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Surface"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: maximum X coordinate of this Surface's axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasBBoxMaxY">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Surface"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: maximum Y coordinate of this Surface's axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasBBoxMaxZ">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Surface"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: maximum Z coordinate of this Surface's axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasBBoxMinX">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Surface"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: minimum X coordinate of this Surface's axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasBBoxMinY">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Surface"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: minimum Y coordinate of this Surface's axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasBBoxMinZ">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Surface"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: minimum Z coordinate of this Surface's axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasColor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManipulationObject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: object color</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMaterial">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManipulationObject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, used as the basis of the FragileObject SWRL rule</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMaxPayload">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Gripper"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: maximum payload the Gripper can carry, in kilograms</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPositionX">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManipulationObject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: object position along the world-frame X axis, in meters. Used by the geometric state reasoner and by the geometric SWRL rule to derive object_on_surface from raw coordinates instead of a manually asserted fact.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPositionY">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManipulationObject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: object position along the world-frame Y axis, in meters. See hasPositionX.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPositionZ">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManipulationObject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: object position along the world-frame Z axis, in meters. See hasPositionX.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasRange">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Sensor"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: effective sensing range of the Sensor, in meters</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasVolume">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManipulationObject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: object volume in liters</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasWeight">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManipulationObject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: object weight in kilograms</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#operator_present">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero-parameter PDDL predicate: set on the world_state individual, not tied to any single Robot/Location/Surface</rdfs:comment>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Gripper">
  <rdfs:subClassOf rdf:resource="#RobotComponent"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Robot's end-effector</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Sensor">
  <rdfs:subClassOf rdf:resource="#RobotComponent"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Robot's perception device</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Location">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fixed feature of the Room the robot can Navigate to (e.g. fridge, sink, cupboard, table)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Room">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Top-level container for the scenario world (e.g. the kitchen)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ManipulationObject">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generic manipulable object type, matches PDDL type manipulation_object</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Surface">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A placement target within a Location (e.g. fridge_top_shelf, table_top)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Can">
  <rdfs:subClassOf rdf:resource="#ManipulationObject"/>
</owl:Class>

<owl:Class rdf:about="#DangerousObject">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Objects that require extra care during manipulation (e.g. Knife); used as a Flavor trigger target</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FragileObject">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasMaterial"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glass</owl:hasValue>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
  <rdfs:subClassOf rdf:resource="#ManipulationObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferred via OWL equivalentClass/hasValue restriction from hasMaterial=glass (SWRL was tried first but Pellet does not apply it in this environment); used as a Flavor trigger target</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Glass">
  <rdfs:subClassOf rdf:resource="#ManipulationObject"/>
</owl:Class>

<owl:Class rdf:about="#RobotComponent">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only concept, not part of the PDDL knowledge: parent class for hardware components fitted on a Robot (grippers, sensors)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#HeavyObject">
  <rdfs:subClassOf rdf:resource="#ManipulationObject"/>
  <rdfs:subClassOf rdf:resource="#DangerousObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manipulation object whose hasWeight exceeds 0.3 kg. Inferred by SWRL rule rule_heavy_object: ManipulationObject(?x) ^ hasWeight(?x,?w) ^ swrlb:greaterThan(?w,0.3) -&gt; HeavyObject(?x). Also DangerousObject (a heavy object requires extra care during manipulation just like Knife); this is what lets glass2 (Fragile + Heavy) also count as Dangerous for the all_activation experiment tag.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Knife">
  <rdfs:subClassOf rdf:resource="#DangerousObject"/>
  <rdfs:subClassOf rdf:resource="#ManipulationObject"/>
</owl:Class>

<owl:Class rdf:about="#LiquidContainer">
  <rdfs:subClassOf rdf:resource="#ManipulationObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manipulation object capable of holding liquid (e.g. glass1, glass2); asserted directly (not inferred), used as a Ch07 showcase Flavor trigger target (AddKinematicRestriction: keep upright while lifting).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SmallObject">
  <rdfs:subClassOf rdf:resource="#ManipulationObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manipulation object small enough that a full DetectObject scan is unnecessary overhead; asserted directly (not inferred), used as a Ch07 showcase Flavor trigger target (Ignore: skip the LocalizeObject branch of DetectObject's Fallback, forcing ScanWorld).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LidarSensor">
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Laser range-finder used for navigation and object detection (fitted on madar)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ForceTorqueSensor">
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wrist-mounted force/torque sensor used to monitor grasp force during manipulation (fitted on tiago); added for ch08's grasp-force-monitoring MRS Flavors.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Robot">
  <owl:equivalentClass rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Local alias for beaware_ontology#Robot, needed because PDDL Manager's extract_types_ontology() only resolves types against the application ontology's own namespace (self.om.onto[name]), not imported ontologies. Matches PDDL type Robot.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ManipulationBehavior">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#hasFlavor"/>
      <owl:hasValue rdf:resource="#flavor_reduce_velocity_for_manipulation"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ch07 Flavor Inheritance example: any Behavior asserted as a ManipulationBehavior
        automatically inherits flavor_reduce_velocity_for_manipulation via this hasValue restriction
        (the reasoner infers the hasFlavor/isFlavorOf triples, no isFlavorOf needed on the flavor itself).
        Empty until a variant types individuals (e.g. b_pick, b_place) as ManipulationBehavior and
        supplies the target flavor individual; see additional_knowledge_yamls/main_demo_flavors.yaml.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NeedsCarefulHandling">
  <rdfs:subClassOf rdf:resource="#ManipulationObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fragile object whose hasWeight also exceeds 0.3 kg, combining two Application properties (hasMaterial-derived FragileObject and hasWeight) into a second-order fact. Inferred by SWRL rule rule_needs_careful_handling: FragileObject(?x) ^ hasWeight(?x,?w) ^ swrlb:greaterThan(?w,0.3) -&gt; NeedsCarefulHandling(?x).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ParallelGripper">
  <rdfs:subClassOf rdf:resource="#Gripper"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Two-finger parallel-jaw end-effector (fitted on tiago)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RGBDCamera">
  <rdfs:subClassOf rdf:resource="#Sensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Colour and depth camera used for object detection (fitted on tiago)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MobileRobot">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasBattery"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#Robot"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Robots capable of self-locomotion and therefore battery-powered (e.g. madar, tiago); used as a Flavor/MRS Trigger target for battery-related checks (ch08 mrs_pick_shared_battery_precondition).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SuctionGripper">
  <rdfs:subClassOf rdf:resource="#Gripper"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vacuum-cup end-effector (fitted on madar)</rdfs:comment>
</owl:Class>

<owl:NamedIndividual rdf:about="#flavor_reduce_velocity_for_manipulation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#world_state">
  <operator_present rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</operator_present>
</owl:NamedIndividual>

