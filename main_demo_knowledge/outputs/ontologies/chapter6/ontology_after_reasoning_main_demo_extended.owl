<owl:NamedIndividual rdf:about="#p_activate_suction">
  <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Primitive"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ch08: dedicated suction-activation primitive inside the `GraspObjectSuction` variant, targeted by MRS Flavors #4 (AisRetriable) and #5 (AhasReleaseCondition).</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#b_signal_grasp_failure">
  <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
  <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SignalGraspFailure</beaw:hasBTid>
  <beaw:BeAwareProperties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SignalGraspFailure</beaw:BeAwareProperties>
  <beaw:hasInputParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">robot</beaw:hasInputParameter>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#p_signal_grasp_failure">
  <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Primitive"/>
  <beaw:isTerminal rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</beaw:isTerminal>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ch08: dedicated alternate-recovery primitive for MRS Flavor #2 (BranchedRecoveryThreshold holdcondition on DriveBase). Used only for the severe (grasp force ~0) branch; `isTerminal=true` is asserted on this individual specifically (rather than on the shared `p_regrasp`) so this ForceFailure-wrapping does not leak into `p_regrasp`'s reuse as a non-terminal recovery in MRS Flavor #3.</rdfs:comment>
  <beaw:BeAwareProperties rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</beaw:BeAwareProperties>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#b_replan_alternate_path">
  <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
  <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ReplanAlternatePath</beaw:hasBTid>
  <beaw:BeAwareProperties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ReplanAlternatePath</beaw:BeAwareProperties>
  <beaw:hasInputParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">robot</beaw:hasInputParameter>
  <beaw:hasInputParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">from</beaw:hasInputParameter>
  <beaw:hasInputParameter rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to</beaw:hasInputParameter>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#p_replan_alternate_path">
  <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Primitive"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ch08: stretch MRS Flavor #8 (EscalatingRecovery on DriveBase). First, non-terminal escalation stage - attempt local path replanning around an obstacle.</rdfs:comment>
</owl:NamedIndividual>

