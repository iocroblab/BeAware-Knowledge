<swrl:Variable rdf:about="urn:swrl#o"/>

<swrl:Variable rdf:about="urn:swrl#y"/>

<swrl:Variable rdf:about="urn:swrl#z"/>

<swrl:Variable rdf:about="urn:swrl#s"/>

<swrl:Variable rdf:about="urn:swrl#minx"/>

<swrl:Variable rdf:about="urn:swrl#maxx"/>

<swrl:Variable rdf:about="urn:swrl#miny"/>

<swrl:Variable rdf:about="urn:swrl#maxy"/>

<swrl:Variable rdf:about="urn:swrl#minz"/>

<swrl:Variable rdf:about="urn:swrl#maxz"/>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#ManipulationObject"/>
          <swrl:argument1 rdf:resource="urn:swrl#o"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#hasPositionX"/>
              <swrl:argument1 rdf:resource="urn:swrl#o"/>
              <swrl:argument2 rdf:resource="urn:swrl#x"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#hasPositionY"/>
                  <swrl:argument1 rdf:resource="urn:swrl#o"/>
                  <swrl:argument2 rdf:resource="urn:swrl#y"/>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#hasPositionZ"/>
                      <swrl:argument1 rdf:resource="urn:swrl#o"/>
                      <swrl:argument2 rdf:resource="urn:swrl#z"/>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:ClassAtom>
                          <swrl:classPredicate rdf:resource="#Surface"/>
                          <swrl:argument1 rdf:resource="urn:swrl#s"/>
                        </swrl:ClassAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#hasBBoxMinX"/>
                              <swrl:argument1 rdf:resource="urn:swrl#s"/>
                              <swrl:argument2 rdf:resource="urn:swrl#minx"/>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:DatavaluedPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="#hasBBoxMaxX"/>
                                  <swrl:argument1 rdf:resource="urn:swrl#s"/>
                                  <swrl:argument2 rdf:resource="urn:swrl#maxx"/>
                                </swrl:DatavaluedPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <rdf:Description>
                                  <rdf:first>
                                    <swrl:DatavaluedPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="#hasBBoxMinY"/>
                                      <swrl:argument1 rdf:resource="urn:swrl#s"/>
                                      <swrl:argument2 rdf:resource="urn:swrl#miny"/>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest>
                                    <rdf:Description>
                                      <rdf:first>
                                        <swrl:DatavaluedPropertyAtom>
                                          <swrl:propertyPredicate rdf:resource="#hasBBoxMaxY"/>
                                          <swrl:argument1 rdf:resource="urn:swrl#s"/>
                                          <swrl:argument2 rdf:resource="urn:swrl#maxy"/>
                                        </swrl:DatavaluedPropertyAtom>
                                      </rdf:first>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:first>
                                            <swrl:DatavaluedPropertyAtom>
                                              <swrl:propertyPredicate rdf:resource="#hasBBoxMinZ"/>
                                              <swrl:argument1 rdf:resource="urn:swrl#s"/>
                                              <swrl:argument2 rdf:resource="urn:swrl#minz"/>
                                            </swrl:DatavaluedPropertyAtom>
                                          </rdf:first>
                                          <rdf:rest>
                                            <rdf:Description>
                                              <rdf:first>
                                                <swrl:DatavaluedPropertyAtom>
                                                  <swrl:propertyPredicate rdf:resource="#hasBBoxMaxZ"/>
                                                  <swrl:argument1 rdf:resource="urn:swrl#s"/>
                                                  <swrl:argument2 rdf:resource="urn:swrl#maxz"/>
                                                </swrl:DatavaluedPropertyAtom>
                                              </rdf:first>
                                              <rdf:rest>
                                                <rdf:Description>
                                                  <rdf:first>
                                                    <swrl:BuiltinAtom>
                                                      <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                                      <swrl:arguments>
                                                        <rdf:Description>
                                                          <rdf:first rdf:resource="urn:swrl#x"/>
                                                          <rdf:rest>
