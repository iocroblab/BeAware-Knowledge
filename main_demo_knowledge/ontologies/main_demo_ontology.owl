        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DetermineGrasp</beaw:hasBTid>
        <rdfs:comment>Computes a grasp and pregrasp pose for the target object.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_determine_placement -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_determine_placement">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeterminePlacement</beaw:hasBTid>
        <rdfs:comment>Computes a placement pose on the target Surface.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_drive_to_location -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_drive_to_location">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DriveToLocation</beaw:hasBTid>
        <rdfs:comment>Drives the robot base along the planned path.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_go_to_grasp -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_go_to_grasp">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GoToGrasp</beaw:hasBTid>
        <rdfs:comment>Moves the arm to the computed grasp pose.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_go_to_placement -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_go_to_placement">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GoToPlacement</beaw:hasBTid>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_go_to_pregrasp -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_go_to_pregrasp">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GoToPregrasp</beaw:hasBTid>
        <rdfs:comment>Moves the arm to the computed pregrasp pose.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_grasp_object -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_grasp_object">
