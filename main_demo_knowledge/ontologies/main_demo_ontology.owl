        <hasRange rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.5</hasRange>
        <rdfs:comment>Range 2.5 m.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago_force_sensor -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago_force_sensor">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ForceTorqueSensor"/>
        <rdfs:comment>Monitors grasp force for the Chapter 8 MRS Flavors.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago_gripper -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago_gripper">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ParallelGripper"/>
        <hasMaxPayload rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</hasMaxPayload>
        <rdfs:comment>Max payload 3.0 kg.</rdfs:comment>
    </owl:NamedIndividual>
    


