    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#MobileRobot"/>
        <hasGripper rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago_gripper"/>
        <hasSensor rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago_camera"/>
        <hasSensor rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago_force_sensor"/>
        <robotAtLocation rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#table"/>
        <robotAtSurface rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#table_top"/>
        <handEmpty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</handEmpty>
        <hasBattery rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</hasBattery>
        <hasFixedEndEffector rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</hasFixedEndEffector>
        <rdfs:comment>Fixed parallel-gripper robot; starts at battery 85%, indicating it could still move, at table/table_top, hand empty.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago_camera -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#tiago_camera">
