<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#"
     xml:base="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:beaw="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#"
     xmlns:onto="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology">
        <owl:imports rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Main Demo scenario ontology for the BeAware Framework. Base pass: world structure (Room/Location/Surface), Navigate/Move/Pick/Place behaviors. Flavors, Context Modes and MRS to be added in later passes.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ApplicationProperties -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ApplicationProperties">
        <rdfs:comment>Parent property for relations used only by the application, not planned over in PDDL</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#PDDLProperties -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#PDDLProperties">
        <rdfs:comment>Parent property for all PDDL predicates in this scenario</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasGripper -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasGripper">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ApplicationProperties"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Gripper"/>
        <rdfs:comment>Application-only relation (not planned over, not part of the PDDL knowledge): the end-effector fitted on this Robot</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasSensor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasSensor">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ApplicationProperties"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Sensor"/>
        <rdfs:comment>Application-only relation (not planned over, not part of the PDDL knowledge): a perception device fitted on this Robot</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#locationInRoom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#locationInRoom">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ApplicationProperties"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Location"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Room"/>
        <rdfs:comment>Application-only relation (not planned over): this Location belongs to this Room</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#objectOnSurface -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#objectOnSurface">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#PDDLProperties"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface"/>
        <rdfs:comment>PDDL predicate: object is currently placed on this Surface</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#robotAtLocation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#robotAtLocation">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#PDDLProperties"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Location"/>
        <rdfs:comment>PDDL predicate: robot&apos;s base is currently at this Location (changed by Navigate)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#robotAtSurface -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#robotAtSurface">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#PDDLProperties"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface"/>
        <rdfs:comment>PDDL predicate: robot&apos;s arm is currently reaching this Surface, within the current Location (changed by Move)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#robotHolding -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#robotHolding">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#PDDLProperties"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:comment>PDDL predicate: robot is currently holding this object</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#surfaceInLocation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#surfaceInLocation">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#PDDLProperties"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Location"/>
        <rdfs:comment>PDDL predicate (static): this Surface belongs to this Location</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#graspForce -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#graspForce">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Application-only property, not part of the PDDL knowledge: current measured grasp force reading from the wrist force/torque sensor, in Newtons. Used for documentation purposes by the MRS Flavors that monitor grasp force (`p_check_grasp_force`); not read by any real BT node since ch08&apos;s correctness checks are structural-BT-generation-only.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#gripForce -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#gripForce">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Application-only property, not part of the PDDL knowledge: current commanded parallel-gripper closing force set-point, in Newtons. Documents the value adapted by the `ParameterAdaptiveRetry` MRS Flavor&apos;s inline Script (`hasParameterModification`) between retries; the actual adaptation happens on a BT blackboard variable, not by writing back to this ontology property.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#handEmpty -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#handEmpty">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>PDDL predicate: robot&apos;s gripper/hand is free</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMaxX -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMaxX">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: maximum X coordinate of this Surface&apos;s axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMaxY -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMaxY">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: maximum Y coordinate of this Surface&apos;s axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMaxZ -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMaxZ">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: maximum Z coordinate of this Surface&apos;s axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMinX -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMinX">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: minimum X coordinate of this Surface&apos;s axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMinY -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMinY">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: minimum Y coordinate of this Surface&apos;s axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMinZ -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBBoxMinZ">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: minimum Z coordinate of this Surface&apos;s axis-aligned bounding box, in the world frame, in meters.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBattery -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBattery">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Robot&apos;s current battery level (0-100). Numeric PDDL fluent; the planner may not support numeric fluents, in which case this stays ontology-only.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasColor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasColor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Application-only property, not part of the PDDL knowledge: object color</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasFixedEndEffector -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasFixedEndEffector">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True when the Robot has a single, non-interchangeable end-effector (its one hasGripper never needs to be selected among alternatives). Asserted directly per Robot, since it reflects a fixed hardware configuration rather than a dynamic runtime condition.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasLowBattery -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasLowBattery">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True when the value of hasBattery for the Robot is below 65. Modeled as a boolean data property rather than a class because hasBattery changes continuously during execution. Inferred by SWRL rule rule_low_battery_robot: Robot(?x) ^ hasBattery(?x,?b) ^ swrlb:lessThan(?b,65.0) -&gt; hasLowBattery(?x,true).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasMaterial -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasMaterial">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Application-only property, used as the basis of the FragileObject SWRL rule</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasMaxPayload -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasMaxPayload">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Gripper"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Application-only property, not part of the PDDL knowledge: maximum payload the Gripper can carry, in kilograms</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasPositionX -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasPositionX">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: object position along the world-frame X axis, in meters. Used by the geometric state reasoner and by the geometric SWRL rule to derive objectOnSurface from raw coordinates instead of a manually asserted fact.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasPositionY -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasPositionY">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: object position along the world-frame Y axis, in meters. See hasPositionX.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasPositionZ -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasPositionZ">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application-only property, not part of the PDDL knowledge: object position along the world-frame Z axis, in meters. See hasPositionX.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasRange -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasRange">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Application-only property, not part of the PDDL knowledge: effective sensing range of the Sensor, in meters</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasVolume -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasVolume">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Application-only property, not part of the PDDL knowledge: object volume in liters</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasWeight -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasWeight">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Application-only property, not part of the PDDL knowledge: object weight in kilograms</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#operatorPresent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#operatorPresent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Zero-parameter PDDL predicate: set on the world_state individual, not tied to any single Robot/Location/Surface</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#vacuumPressure -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#vacuumPressure">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Application-only property, not part of the PDDL knowledge: current measured suction vacuum pressure reading, in kPa. Used for documentation purposes by the MRS Flavors that monitor vacuum pressure (`p_check_vacuum_pressure`); not read by any real BT node since ch08&apos;s correctness checks are structural-BT-generation-only.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Can -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Can">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#DangerousObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#DangerousObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
        <rdfs:comment>Objects that require extra care during manipulation (e.g. Knife); used as a Flavor trigger target</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ForceTorqueSensor -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ForceTorqueSensor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Sensor"/>
        <rdfs:comment>Wrist-mounted force/torque sensor used to monitor grasp force during manipulation (fitted on tiago); added for ch08&apos;s grasp-force-monitoring MRS Flavors.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#FragileObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#FragileObject">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasMaterial"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glass</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
        <rdfs:comment>Inferred via OWL equivalentClass/hasValue restriction from hasMaterial=glass (SWRL was tried first but Pellet does not apply it in this environment); used as a Flavor trigger target</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Glass -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Glass">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Gripper -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Gripper">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#RobotComponent"/>
        <rdfs:comment>A Robot&apos;s end-effector</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#HeavyObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#HeavyObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#DangerousObject"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manipulation object whose hasWeight exceeds 0.3 kg. Inferred by SWRL rule rule_heavy_object: ManipulationObject(?x) ^ hasWeight(?x,?w) ^ swrlb:greaterThan(?w,0.3) -&gt; HeavyObject(?x). Also DangerousObject (a heavy object requires extra care during manipulation just like Knife); this is what lets glass2 (Fragile + Heavy) also count as Dangerous for the all_activation experiment tag.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Knife -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Knife">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#DangerousObject"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#LiquidContainer -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#LiquidContainer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:comment>Manipulation object capable of holding liquid (e.g. glass1, glass2); asserted directly (not inferred), used as a Ch07 showcase Flavor trigger target (AddKinematicRestriction: keep upright while lifting).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Location -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Location">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
        <rdfs:comment>A fixed feature of the Room the robot can Navigate to (e.g. fridge, sink, cupboard, table)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationBehavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationBehavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#hasFlavor"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#flavor_reduce_velocity_for_manipulation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Ch07 Flavor Inheritance example: any Behavior asserted as a ManipulationBehavior
        automatically inherits flavor_reduce_velocity_for_manipulation via this hasValue restriction
        (the reasoner infers the hasFlavor/isFlavorOf triples, no isFlavorOf needed on the flavor itself).
        Empty until a variant types individuals (e.g. b_pick, b_place) as ManipulationBehavior and
        supplies the target flavor individual; see the scenario YAML files under main_demo_knowledge/scenarios/.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
        <rdfs:comment>Generic manipulable object type, matches PDDL type manipulation_object</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#MobileRobot -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#MobileRobot">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Robot"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#hasBattery"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Robots capable of self-locomotion and therefore battery-powered (e.g. madar, tiago); used as a Flavor/MRS Trigger target for battery-related checks (ch08 mrs_pick_shared_battery_precondition).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#NeedsCarefulHandling -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#NeedsCarefulHandling">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fragile object whose hasWeight also exceeds 0.3 kg, combining two Application properties (hasMaterial-derived FragileObject and hasWeight) into a second-order fact. Inferred by SWRL rule rule_needs_careful_handling: FragileObject(?x) ^ hasWeight(?x,?w) ^ swrlb:greaterThan(?w,0.3) -&gt; NeedsCarefulHandling(?x).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ParallelGripper -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ParallelGripper">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Gripper"/>
        <rdfs:comment>Two-finger parallel-jaw end-effector (fitted on tiago)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ProximitySensor -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ProximitySensor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Sensor"/>
        <rdfs:comment>Range-based proximity sensor used for navigation and object detection (fitted on madar)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#RGBDCamera -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#RGBDCamera">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Sensor"/>
        <rdfs:comment>Colour and depth camera used for object detection (fitted on tiago)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#RobotComponent -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#RobotComponent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
        <rdfs:comment>Application-only concept, not part of the PDDL knowledge: parent class for hardware components fitted on a Robot (grippers, sensors)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Room -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Room">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
        <rdfs:comment>Top-level container for the scenario world (e.g. the kitchen)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Sensor -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Sensor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#RobotComponent"/>
        <rdfs:comment>A Robot&apos;s perception device</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#SmallObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#SmallObject">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#ManipulationObject"/>
        <rdfs:comment>Manipulation object small enough that a full DetectObject scan is unnecessary overhead; asserted directly (not inferred), used as a Ch07 showcase Flavor trigger target (Ignore: skip the LocalizeObject branch of DetectObject&apos;s Fallback, forcing ScanWorld).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#SuctionGripper -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#SuctionGripper">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Gripper"/>
        <rdfs:comment>Vacuum-cup end-effector (fitted on madar)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#Surface">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Object"/>
        <rdfs:comment>A placement target within a Location (e.g. fridge_top_shelf, table_top)</rdfs:comment>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#world_state -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#world_state">
        <operatorPresent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</operatorPresent>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_attempt_grasp -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_attempt_grasp">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AttemptGrasp</beaw:hasBTid>
        <rdfs:comment>Sequence orchestrating a full grasp attempt (open gripper, determine grasp, approach, close gripper).</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_battery_reserve -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_battery_reserve">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CheckBatteryReserve</beaw:hasBTid>
        <rdfs:comment>Checks that the battery reserve is sufficient before Navigate.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_detection_confidence -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_detection_confidence">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CheckDetectionConfidence</beaw:hasBTid>
        <rdfs:comment>Checks that object detection confidence is high enough to proceed.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_grasp_force -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_grasp_force">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CheckGraspForce</beaw:hasBTid>
        <rdfs:comment>Monitors the measured grasp force during a Pick.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_gripper_ready -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_gripper_ready">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CheckGripperReady</beaw:hasBTid>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_object_on_expected_surface -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_object_on_expected_surface">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CheckObjectOnExpectedSurface</beaw:hasBTid>
        <rdfs:comment>Verifies the object is on the Surface expected by the plan.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_object_stable_on_surface -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_object_stable_on_surface">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CheckObjectStableOnSurface</beaw:hasBTid>
        <rdfs:comment>Verifies the placed object remains stable on its Surface.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_vacuum_pressure -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_check_vacuum_pressure">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CheckVacuumPressure</beaw:hasBTid>
        <rdfs:comment>Monitors the measured suction vacuum pressure during a suction grasp.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_confirm_tool_selection -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_confirm_tool_selection">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ConfirmToolSelection</beaw:hasBTid>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_detect_object -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_detect_object">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DetectObject</beaw:hasBTid>
        <rdfs:comment>Fallback that localizes, or otherwise scans the world for, the target object.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_determine_grasp -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_determine_grasp">
