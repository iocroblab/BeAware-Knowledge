        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Move</beaw:hasBTid>
        <rdfs:comment>Plan-Level Behavior for the PDDL action `move`; moves the arm to reach a target Surface.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_move_arm_to_surface -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_move_arm_to_surface">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MoveArmToSurface</beaw:hasBTid>
        <rdfs:comment>Moves the arm along the planned trajectory to reach the target Surface.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_navigate -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_navigate">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#PlanLevelBehavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Navigate</beaw:hasBTid>
        <rdfs:comment>Plan-Level Behavior for the PDDL action `navigate`; drives the robot base between Locations.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_operator_confirm_grasp -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_operator_confirm_grasp">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OperatorConfirmGrasp</beaw:hasBTid>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_pick -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_pick">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#PlanLevelBehavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pick</beaw:hasBTid>
        <rdfs:comment>Plan-Level Behavior for the PDDL action `pick`; grasps an object from a Surface.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_place -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_place">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#PlanLevelBehavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Place</beaw:hasBTid>
        <rdfs:comment>Plan-Level Behavior for the PDDL action `place`; releases the held object onto a Surface.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_plan_arm_trajectory -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_plan_arm_trajectory">
