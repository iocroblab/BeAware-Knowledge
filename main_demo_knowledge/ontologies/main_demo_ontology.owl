        <beaw:isTerminal rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</beaw:isTerminal>
        <rdfs:comment>Reports a failed grasp attempt; terminal recovery (isTerminal).</rdfs:comment>
    </owl:NamedIndividual>
    


