        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SelectTool</beaw:hasBTid>
        <rdfs:comment>Selects the end-effector or grasp strategy for the target object.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_signal_grasp_failure -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_signal_grasp_failure">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SignalGraspFailure</beaw:hasBTid>
        <rdfs:comment>Terminal recovery Behavior that reports a failed grasp attempt.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_tighten_grip -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_tighten_grip">
