        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LiftObject</beaw:hasBTid>
        <rdfs:comment>Lifts the grasped object clear of the source Surface.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_localize_object -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_localize_object">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LocalizeObject</beaw:hasBTid>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_move -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_move">
