        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regrasp</beaw:hasBTid>
        <rdfs:comment>Recovery Behavior that repeats the grasp attempt after a failure.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_release_object -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_release_object">
