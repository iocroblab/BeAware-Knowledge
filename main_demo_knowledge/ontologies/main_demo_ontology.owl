        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TightenGrip</beaw:hasBTid>
        <rdfs:comment>Recovery Behavior that increases grip force after a low grasp-force reading.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_verify_grasp -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_verify_grasp">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VerifyGrasp</beaw:hasBTid>
    </owl:NamedIndividual>
    


