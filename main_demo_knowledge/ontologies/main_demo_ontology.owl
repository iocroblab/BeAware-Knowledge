        <beaw:isTerminal rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</beaw:isTerminal>
        <rdfs:comment>Requests assistance from a human operator; terminal recovery stage (isTerminal).</rdfs:comment>
    </owl:NamedIndividual>
    


