        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ReleaseObject</beaw:hasBTid>
        <rdfs:comment>Opens the gripper to release the held object.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_replan_alternate_path -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_replan_alternate_path">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ReplanAlternatePath</beaw:hasBTid>
        <rdfs:comment>Recovery Behavior computing an alternate path around an obstacle.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_reposition -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_reposition">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reposition</beaw:hasBTid>
        <rdfs:comment>Recovery Behavior that repositions the robot.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_reposition_object -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_reposition_object">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepositionObject</beaw:hasBTid>
        <rdfs:comment>Recovery Behavior that repositions a misplaced object on its Surface.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_request_operator_assistance -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_request_operator_assistance">
        <rdf:type rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
        <beaw:hasBTid rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RequestOperatorAssistance</beaw:hasBTid>
        <rdfs:comment>Terminal recovery Behavior requesting help from a human operator.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_retreat_arm -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2026/8/main_demo_ontology#b_retreat_arm">
