    </owl:Class>
    


    <!-- http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#RecoveryPriorityLink -->

    <owl:Class rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#RecoveryPriorityLink">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Link"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#linksOrderedRecovery"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Behavior"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/oriol.ruiz/ontologies/2023/8/beaware_ontology#Primitive"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Reifies a single recovery with an explicit escalation order for use in EscalatingRecovery (hasOrderedRecovery) or ConWithEscalatingRecovery. linksOrderedRecovery points to the recovery; hasEscalationOrder gives the sorting key (lower = tried first).</rdfs:comment>
    </owl:Class>
    


